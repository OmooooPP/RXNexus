rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Entity-specific shape validation
    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128
        && data.username is string && data.username.size() <= 128
        && data.name is string && data.name.size() <= 256
        && data.role is string && data.role.size() <= 64;
    }

    function isValidDrug(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 256
        && data.stockCode is string && data.stockCode.size() <= 64
        && data.type is string && (data.type == 'General' || data.type == 'Oncology');
    }

    function isValidBooking(data) {
      return data.id is string && data.id.size() <= 128
        && data.hn is string && data.hn.size() <= 32
        && data.patientName is string && data.patientName.size() <= 256
        && data.bookingDate is string && data.bookingDate.size() <= 32
        && data.mode is string && (data.mode == 'General' || data.mode == 'Oncology');
    }

    function isValidLog(data) {
      return data.id is string && data.id.size() <= 128
        && data.userName is string && data.userName.size() <= 256
        && data.action is string && data.action.size() <= 256;
    }

    // Collection Security Rules
    match /users/{userId} {
      allow read: if true; // Allow query lookup of catalog profiles
      allow write: if isValidId(userId) && isValidUser(request.resource.data);
    }

    match /drugs/{drugId} {
      allow read: if true;
      allow write: if isValidId(drugId) && isValidDrug(request.resource.data);
    }

    match /bookings/{bookingId} {
      allow read: if true;
      allow write: if isValidId(bookingId) && isValidBooking(request.resource.data);
    }

    match /logs/{logId} {
      allow read: if true;
      allow write: if isValidId(logId) && isValidLog(request.resource.data);
    }
  }
}
